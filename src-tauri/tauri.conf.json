{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWL Pricing and Inventory Control",
  "version": "1.1.0",
  "identifier": "au.com.stanwoottonlocksmiths.swl-pricing",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SWL Pricing and Inventory Control",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Stan Wootton Locksmiths",
    "shortDescription": "Local-first SWL pricing and inventory control",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
