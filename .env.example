# SWL Pricing and Inventory Control - server environment (placeholders only).
# Copy to .env and fill in real values. Never commit a real key.

# SerpAPI key for live Google Shopping (Australia) competitor search.
# Without it the application still runs; the search surface reports
# "live search not configured" and manual entry remains available.
SERPAPI_KEY=your-serpapi-key-here

# "serpapi" (default) or "fixture" for offline deterministic results.
SWL_SEARCH_PROVIDER=serpapi

# Where the server persists catalogue items, price history, approvals,
# competitor references and the source registry. Default: server/data
# SWL_DATA_DIR=server/data

# API server port. Default: 8787
# PORT=8787
