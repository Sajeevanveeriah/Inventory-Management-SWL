# SWL server - copy to .env and keep that file local. Never commit credentials.
PORT=8787
SWL_DATA_DIR=server/data

# Licensed shopping provider. A key alone never authorises a paid request.
SERPAPI_KEY=replace_with_serpapi_key
SERPAPI_LOCATION=Geelong, Victoria, Australia
SWL_PAID_CALLS_ENABLED=false
# Examples only. Replace both with an explicitly approved pessimistic budget
# and reservation before changing SWL_PAID_CALLS_ENABLED to true.
SWL_PROVIDER_COST_CEILING_CENTS=1000
SWL_PROVIDER_COST_PER_CALL_CENTS=5

# API-only Vercel deployment for the GitHub Pages live-search path.
# Generate both secrets independently. Never reuse the SerpAPI or Redis token.
SWL_FRONTEND_ORIGIN=https://sajeevanveeriah.github.io
SWL_ACCESS_TOKEN_PEPPER=replace_with_at_least_32_random_characters
SWL_REDIS_REST_URL=https://replace_with_upstash_redis_rest_url
SWL_REDIS_REST_TOKEN=replace_with_upstash_redis_rest_token
SWL_PROVIDER_BUDGET_PERIOD=replace_with_current_YYYY-MM
SWL_SEARCH_PER_USER_PER_MINUTE=4
SWL_SEARCH_GLOBAL_PER_MINUTE=10
SWL_SEARCH_CACHE_TTL_SECONDS=3600

# Optional eBay Browse API (Australian marketplace)
EBAY_CLIENT_ID=replace_with_ebay_client_id
EBAY_CLIENT_SECRET=replace_with_ebay_client_secret
EBAY_MARKETPLACE_ID=EBAY_AU

# Optional authorised generic JSON feed. HTTPS host must be allowlisted.
SWL_HTTP_FEED_URL=https://supplier.example.com/offers.json
SWL_HTTP_FEED_ALLOWED_HOSTS=supplier.example.com
SWL_HTTP_FEED_BEARER_TOKEN=replace_with_feed_token

# Optional self-hosted discovery. Results are discovery evidence, not verified offers.
SWL_SEARXNG_URL=http://127.0.0.1:8080
SWL_SEARXNG_ALLOW_LOCAL=false

# Safety defaults. Paid provider calls remain disabled unless deliberately changed.
SWL_BATCH_CONCURRENCY=3
SWL_RETENTION_DAYS=180
