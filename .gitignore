# Dependencies and build output
node_modules/
dist/
coverage/
.vercel/
/src-tauri/target/
/src-tauri/gen/
/src-tauri/permissions/autogenerated/
playwright-report/
test-results/
desktop-e2e-evidence/
.tools/
.ci-upgrade/
*.tsbuildinfo

# Environment and secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Real business data must never enter this public repository.
# Supplier exports, ServiceM8 exports and generated outputs live outside Git.
# Synthetic fixtures are allowed only under tests/fixtures/ and src/demo/.
*.xlsx
*.xls
*.csv
!tests/fixtures/*.csv
!tests/fixtures/*.xlsx
/data/
server/data/
.e2e-data/
.e2e-seed-data/
/exports/
/imports/
/output/
/reports/
*servicem8*
*ServiceM8*
*supplier-export*
*price-list*
*pricelist*
# ...but the patterns above are about DATA, not about the word. Source files
# that implement the ServiceM8 contract legitimately carry it in their names,
# and without these exceptions `git add` drops them silently and CI fails on a
# module that exists locally. Data files are still blocked: every export format
# (*.csv, *.xlsx, *.xls) is excluded wholesale above, and these exceptions only
# re-admit code and documentation.
!src/**/*ervice[mM]8*.ts
!src/**/*ervice[mM]8*.tsx
!tests/**/*ervice[mM]8*.ts
!e2e/**/*ervice[mM]8*.ts
!desktop-e2e/**/*ervice[mM]8*.ts
!docs/**/*ervice[mM]8*.md
rollback-*
import-candidate-*
change-report-*
exceptions-*
audit-summary-*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local screenshots captured during visual validation
/screenshots/
swl-start.log
