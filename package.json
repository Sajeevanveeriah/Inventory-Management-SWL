{
  "name": "swl-pricing-inventory-control",
  "private": true,
  "version": "1.2.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Stan Wootton Locksmiths",
  "description": "SWL Pricing and Inventory Control — local-first supplier price comparison and ServiceM8 import preparation for Stan Wootton Locksmiths.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "desktop:build": "tauri build --bundles nsis -- --locked",
    "desktop:dev": "tauri dev",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs --trusted-origin http://127.0.0.1:5173 --trusted-origin http://localhost:5173 --trusted-origin http://127.0.0.1:4173 --trusted-origin http://localhost:4173",
    "server:fixture": "node --env-file-if-exists=.env server/index.mjs --fixture --trusted-origin http://127.0.0.1:5173 --trusted-origin http://localhost:5173 --trusted-origin http://127.0.0.1:4173 --trusted-origin http://localhost:4173",
    "seed": "node server/seed.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:local": "node scripts/run-local-e2e.mjs",
    "e2e:desktop": "wdio run wdio.conf.ts",
    "test:local": "node scripts/local-test-platform.mjs",
    "test:portable": "node scripts/portable-test.mjs",
    "test:portable:build": "node scripts/portable-test.mjs --build-only",
    "check:data-safety": "node scripts/check-no-business-data.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:pages": "node scripts/check-pages-build.mjs",
    "check:desktop-boundaries": "node scripts/check-desktop-production-boundaries.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "big.js": "7.0.1",
    "exceljs": "4.4.0",
    "idb": "8.0.3",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/big.js": "7.0.0",
    "@types/jasmine": "5.1.15",
    "@types/node": "22.20.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/jasmine-framework": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "22.22.2",
    "npm": ">=10"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
